# ══════════════════════════════════════════════════════════════════════════════
# Closira Enquiry Engine — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your environment.

# Application
APP_NAME=Closira Enquiry Engine
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Database
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./closira.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/closira

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# SOP Matching — minimum keyword hits for a confident match
SOP_CONFIDENCE_THRESHOLD=1
